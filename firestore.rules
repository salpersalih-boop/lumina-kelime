rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı profili: yalnızca sahibi okur; kullanıcı kendi "role" alanını DEĞİŞTİREMEZ
    // (admin yapmak için Firebase Console'dan role: "admin" yazın).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && !('role' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if false;

      // Kelime çalışma ilerlemesi (dil başına bir belge)
      match /progress/{lang} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
                              && lang.matches('^[a-z0-9]{2,12}$')
                              && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
                              && request.resource.data.json is string
                              && request.resource.data.json.size() < 900000
                              && request.resource.data.updatedAt is number;
      }
    }

    // TÖMER kişisel çalışma içeriği (telifli kitap içeriği): yalnızca sahibinin hesabı okur/yazar.
    // Doğrulanmış e-posta şart (Google ile giriş otomatik doğrulanmış sayılır).
    match /tomer/{docId} {
      allow read, write: if request.auth != null
                         && request.auth.token.email == 'salpersalih@gmail.com'
                         && request.auth.token.email_verified == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
