{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "firestore.rules", "README.md", "**/.*", "**/node_modules/**",
      "Lumina.Api/**", "Lumina.Api.New/**", "Database/**", "temp_extracted/**", ".github/**",
      "**/*.xlsx", "**/*.sql", "**/*.txt", "**/*.py", "update_script.js", "**/*.cs", "**/*.csproj"
    ],
    "headers": [
      { "source": "**/*.@(html|js|css|csv)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "service-worker.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
